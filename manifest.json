{
  "manifest_version": 3,
  "name": "WoW Armory Lite",
  "version": "0.1.1",
  "description": "Display a World of Warcraft character summary from Raider.IO.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "WoW Armory Lite",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raider.io/*",
    "https://www.wowhead.com/*",
    "https://worldofwarcraft.blizzard.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wow-armory-lite@micaux.com"
    }
  }
}
